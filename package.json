{
  "name": "minehub",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "db:generate": "prisma generate",
    "start": "tsx server/index.ts",
    "lint": "vp lint",
    "db:dev": "prisma migrate dev",
    "dev": "concurrently -k -n web,api \"vp dev\" \"node --watch --import tsx server/index.ts\"",
    "admin:create": "tsx scripts/admin.ts",
    "test": "vp test run",
    "keys:init": "tsx scripts/keys.ts",
    "db:migrate": "prisma migrate deploy",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json",
    "build": "prisma generate && tsc -p tsconfig.app.json && tsc -p tsconfig.server.json && vp build",
    "format": "vp fmt",
    "preview": "vp preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/passkey": "^1.7.3",
    "@better-auth/prisma-adapter": "^1.7.3",
    "@daypicker/react": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.102.8",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7",
    "lucide-react": "^1.43.0",
    "nodemailer": "^10.0.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "redis": "^6.2.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "skinview3d": "^3.4.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "concurrently": "^10.0.5",
    "globals": "^17",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "~6",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11"
  }
}
